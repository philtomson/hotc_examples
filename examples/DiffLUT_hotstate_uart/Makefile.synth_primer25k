# Makefile.synth_primer25k — Tang Primer 25K (Gowin GW5A-25) synthesis for
# DiffLUT_hotstate_uart: trained K=4 DiffLUT-Net MNIST classifier (2000+1000
# LUT4 neurons), UART image load / result byte out.
#
# Flow: yosys (synth_gowin) → nextpnr-himbaechel → gowin_pack → openFPGALoader
#   make -f Makefile.synth_primer25k pack    bitstream
#   make -f Makefile.synth_primer25k prog    bitstream + flash
#
# NOTE: synthesize with the SYSTEM yosys (default `yosys` on PATH, v0.56).
# The oss-cad-suite yosys (v0.69) emits $buf cells that nextpnr's GW5A
# backend cannot place ("no BELs remaining to implement cell type '$buf'").
#
# Utilization (this design): LUT4 6949/23040 (30%), ALU 1012 (GroupSum
# carry trees), DFF 4042 (17%), IOB 5. Fmax 92.7 MHz.

IP_DIR    = ../../IP
BUILD     = build_primer25k

-include ../../tools.mk
-include ../../local.mk

GOWIN_DEVICE = GW5A-LV25MG121NES
GOWIN_FAMILY = GW5A-25A
TOP          = dlut_hw_top_uart
CST          = dlut_primer25k_uart.cst

SRCS = dlut_hw_top_uart.v \
       dlut_uart_loader_template.v \
       image_reg.v \
       argmax10.v \
       logic_net.v \
       $(BUILD)/uart_tx_template.v $(BUILD)/uart_rx_template.v \
       $(IP_DIR)/hotstate.sv $(IP_DIR)/microcode.sv $(IP_DIR)/control.sv \
       $(IP_DIR)/next_address.sv $(IP_DIR)/timer.sv $(IP_DIR)/variable.sv \
       $(IP_DIR)/switch.sv $(IP_DIR)/stack.sv

.PHONY: synth pnr pack prog clean_synth

synth:
	$(YOSYS) -ql synth_primer25k.log -p " \
	  read_verilog $(SRCS); \
	  hierarchy -top $(TOP); \
	  synth_gowin -family gw5a -nolutram -top $(TOP) -json synth_primer25k.json; \
	  stat"
	@echo "=== synthesis done — see synth_primer25k.log ==="

pnr: synth
	$(NEXTPNR_HIMB) \
	    --device $(GOWIN_DEVICE) \
	    -o family=$(GOWIN_FAMILY) \
	    --json synth_primer25k.json \
	    -o cst=$(CST) \
	    --timing-allow-fail \
	    --write pnr_primer25k.json
	@echo "=== P&R done — see pnr_primer25k.json ==="

pack: pnr
	$(GOWIN_PACK) -d $(GOWIN_FAMILY) -o design_primer25k.fs pnr_primer25k.json
	@echo "=== Bitstream: design_primer25k.fs ==="

prog: pack
	$(OPENFPGALoader) -b tangprimer25k design_primer25k.fs
	@echo "=== Programming done ==="

clean_synth:
	rm -f synth_primer25k.json synth_primer25k.log pnr_primer25k.json design_primer25k.fs
