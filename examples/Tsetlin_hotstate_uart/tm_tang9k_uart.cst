// tm_tang9k_uart.cst
// Pin constraints for Tsetlin_hotstate_uart on Sipeed Tang Nano 9K FPGA.
// clk/rst_n/uart_txd/uart_rxd pins match examples/webserver's
// webserver_tang9k.cst exactly -- confirmed correct on real hardware this
// session (loopback + full HTTP round-trip through bridge.py).

// Clock (27 MHz on-board oscillator)
IO_LOC "clk" 52;
IO_PORT "clk" PULL_UP=NONE IO_TYPE=LVCMOS33;

// Reset Button (active-low)
IO_LOC "rst_n" 4;
IO_PORT "rst_n" PULL_UP=UP IO_TYPE=LVCMOS33;

// UART (USB serial bridge)
IO_LOC "uart_txd" 17;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33;

IO_LOC "uart_rxd" 18;
IO_PORT "uart_rxd" PULL_UP=UP IO_TYPE=LVCMOS33;

// Status LED (active-low on Tang Nano 9K): lit at idle, off during inference
IO_LOC "done_led" 10;
IO_PORT "done_led" IO_TYPE=LVCMOS33;
