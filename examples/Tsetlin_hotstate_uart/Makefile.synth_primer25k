# Makefile.synth_primer25k — Tang Primer 25K (Gowin GW5A-25) synthesis
# for Tsetlin_hotstate_uart (UART image load/result instead of SPI).
#
# Toolchain:
#   Synthesis:  Yosys  synth_gowin
#   PnR:        nextpnr-himbaechel  (Gowin Himbaechel backend)
#   Pack:       gowin_pack  (produces .fs bitstream)
#   Program:    openFPGALoader  (tangprimer25k preset; flashing needs
#               --unprotect-flash, see prog_flash below)
#
# Full flow:  make -f Makefile.synth_primer25k prog
#
# Resources: same tm_core_v2.v/tm_top.v as examples/Tsetlin_hotstate (21/26
# BSRAM, ~80%, tight -- see that example's README), plus two small UART
# hotstate machines and one loader hotstate machine in place of
# spi_deserializer.v -- expect LUT/DFF usage to be similar or slightly
# higher, BSRAM unchanged (still dominated by the 200-clause mask ROMs).
#
# The *_template.v/*.mem/*.vh files below (including build_primer25k/, the
# retimed 50 MHz UART machines) are hotc's OUTPUT, checked in as-is -- this
# repo doesn't ship the hotc compiler itself, so there is no `generate`
# step. If you're not modifying the design, `make prog` just builds and
# flashes what's here.

IP_DIR    = ../../IP

-include ../../tools.mk
-include ../../local.mk

# ── Gowin device parameters ───────────────────────────────────────────────
GOWIN_DEVICE = GW5A-LV25MG121NES
GOWIN_FAMILY = GW5A-25A
TOP          = tm_hw_top_uart
CST          = tm_primer25k_uart.cst

# ── UART bit timing (this board is 50 MHz; Tang Nano 9K is 27 MHz) ────────
# The two UART machines encode the baud divisor as a cycle count in C, which
# is why build_primer25k/ holds separately-generated uart_tx/uart_rx output
# retimed for 50 MHz, rather than reusing the 27 MHz copies in this directory.
BUILD := build_primer25k

# ── Pre-generated hotc controller output (checked in, not rebuilt here) ───
HOTC_TEMPLATES = tm_seq_controller_template.v tm_uart_loader_template.v \
                 $(BUILD)/uart_tx_template.v $(BUILD)/uart_rx_template.v

# ── Design sources (same tm_core_v2.v/tm_top.v as examples/Tsetlin_hotstate) ─
SRCS = tm_hw_top_uart.v \
       tm_top.v \
       tm_core_v2.v \
       $(HOTC_TEMPLATES) \
       $(IP_DIR)/hotstate.sv \
       $(IP_DIR)/microcode.sv \
       $(IP_DIR)/control.sv \
       $(IP_DIR)/next_address.sv \
       $(IP_DIR)/timer.sv \
       $(IP_DIR)/variable.sv \
       $(IP_DIR)/switch.sv \
       $(IP_DIR)/stack.sv

.PHONY: synth pnr pack prog clean_synth

# ── Synthesis ────────────────────────────────────────────────────────────
synth:
	$(TOOL_BANNER)
	@echo "=== Yosys Gowin synthesis for $(TOP) (Tang Nano 9K) ==="
	$(YOSYS) -ql synth_primer25k.log -p " \
	  read_verilog -sv $(SRCS); \
	  hierarchy -check -top $(TOP); \
	  synth_gowin -family gw5a -nolutram -top $(TOP) -json synth_primer25k.json; \
	  stat"
	@echo "=== Gowin 9K synthesis done — see synth_primer25k.log ==="

# ── Place and route ──────────────────────────────────────────────────────
# --timing-allow-fail: nextpnr-himbaechel reports 56 hold/min violations on this
# family, the worst around 0.2ns clk-to-q + 0.77ns routing on the hotstate
# next-address path. The Tang Nano 20K webserver flow carries the same flag for
# the same reason (its comment: the hold model is conservative here). Setup is
# not the issue -- Fmax comes back at 106 MHz against a 50 MHz clock. Treat this
# as provisional until the design is confirmed working on real hardware, which
# is the bar the webserver port was held to.
pnr: synth
	@echo "=== nextpnr-himbaechel Gowin 9K place and route ==="
	$(NEXTPNR_HIMB) \
	    --device $(GOWIN_DEVICE) \
	    -o family=$(GOWIN_FAMILY) \
	    --json synth_primer25k.json \
	    -o cst=$(CST) \
	    --timing-allow-fail \
	    --write pnr_primer25k.json
	@echo "=== Gowin 9K P&R done — see pnr_primer25k.json ==="

# ── Pack bitstream ───────────────────────────────────────────────────────
pack: pnr
	@echo "=== gowin_pack: creating Primer 25K bitstream ==="
	$(GOWIN_PACK) -d $(GOWIN_FAMILY) -o design_primer25k.fs pnr_primer25k.json
	@echo "=== Bitstream: design_primer25k.fs ==="

# ── Program ───────────────────────────────────────────────────────────────
prog: pack
	@echo "=== openFPGALoader: programming Tang Primer 25K (SRAM) ==="
	$(OPENFPGALOADER) -b tangprimer25k design_primer25k.fs
	@echo "=== Programming done ==="

# ── Clean ─────────────────────────────────────────────────────────────────
clean_synth:
	rm -f synth_primer25k.json synth_primer25k.log pnr_primer25k.json design_primer25k.fs
