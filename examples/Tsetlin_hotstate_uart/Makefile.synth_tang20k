# Makefile.synth_tang20k — Tang Nano 20K (Gowin GW2AR-LV18QN88C8/I7) synthesis
# for Tsetlin_hotstate_uart (UART image load/result instead of SPI).
#
# Toolchain:
#   Synthesis:  Yosys  synth_gowin
#   PnR:        nextpnr-himbaechel  (Gowin Himbaechel backend)
#   Pack:       gowin_pack  (produces .fs bitstream)
#   Program:    openFPGALoader  (Tang Nano 9K board preset)
#
# Full flow:  make -f Makefile.synth_tang20k prog
#
# Resources: same tm_core_v2.v/tm_top.v as examples/Tsetlin_hotstate (21/26
# BSRAM, ~80%, tight -- see that example's README), plus two small UART
# hotstate machines and one loader hotstate machine in place of
# spi_deserializer.v -- expect LUT/DFF usage to be similar or slightly
# higher, BSRAM unchanged (still dominated by the 200-clause mask ROMs).
#
# The *_template.v/*.mem/*.vh files below are hotc's OUTPUT, checked in
# as-is -- this repo doesn't ship the hotc compiler itself, so there is no
# `generate` step. If you're not modifying the design, `make prog` (or
# `verify`, below) just builds and flashes what's here.

IP_DIR    = ../../IP

-include ../../tools.mk
-include ../../local.mk

# ── Gowin device parameters ───────────────────────────────────────────────
# -noalu: THE fix for this part, not a tuning knob. yosys's inferred ALU carry
# cells miscompute on GW2A-18C -- see YosysHQ/apicula#514 and KNOWN_ISSUES.md.
# With ALU inference this design got 5 of 7 placements wrong (90..98/100 on
# batch_ref.bin, a different MNIST class broken in each); with -noalu, 4 of 4
# placements score 100/100. The adders become LUT trees: LUT4 2348 -> 2461, DFF
# and BSRAM unchanged, so it costs essentially nothing here.
#
# This REPLACES the pinned placement seed that used to be here. A seed only made
# one lucky placement repeatable; this removes the fault.

GOWIN_DEVICE = GW2AR-LV18QN88C8/I7
GOWIN_FAMILY = GW2A-18C
TOP          = tm_hw_top_uart
CST          = tm_tang20k_uart.cst

# ── Pre-generated hotc controller output (checked in, not rebuilt here) ───
HOTC_TEMPLATES = tm_seq_controller_template.v tm_uart_loader_template.v \
                 uart_tx_template.v uart_rx_template.v

# ── Design sources (same tm_core_v2.v/tm_top.v as examples/Tsetlin_hotstate) ─
SRCS = tm_hw_top_uart.v \
       tm_top.v \
       tm_core_v2.v \
       $(HOTC_TEMPLATES) \
       $(IP_DIR)/hotstate.sv \
       $(IP_DIR)/microcode.sv \
       $(IP_DIR)/control.sv \
       $(IP_DIR)/next_address.sv \
       $(IP_DIR)/timer.sv \
       $(IP_DIR)/variable.sv \
       $(IP_DIR)/switch.sv \
       $(IP_DIR)/stack.sv

.PHONY: synth pnr pack prog clean_synth verify

# ── Synthesis ────────────────────────────────────────────────────────────
synth:
	@echo "=== Yosys Gowin synthesis for $(TOP) (Tang Nano 9K) ==="
	$(YOSYS) -ql synth_tang20k.log -p " \
	  read_verilog -sv $(SRCS); \
	  hierarchy -check -top $(TOP); \
	  synth_gowin -noalu -top $(TOP) -json synth_tang20k.json; \
	  stat"
	@echo "=== Gowin 9K synthesis done — see synth_tang20k.log ==="

# ── Place and route ──────────────────────────────────────────────────────
pnr: synth
	@echo "=== nextpnr-himbaechel Gowin 20K place and route ==="
	# --timing-allow-fail: nextpnr-himbaechel reports ~72 small hold violations
	# (worst -0.12 ns) inside the shared hotstate.sv IP core, exactly as
	# examples/webserver's own Tang Nano 20K build documents and accepts. Setup
	# timing has large margin, and this design is verified 100/100 on real
	# hardware across four placements with the flag in place (`make verify`).
	$(NEXTPNR_HIMB) \
	    --device $(GOWIN_DEVICE) \
	    -o family=$(GOWIN_FAMILY) \
	    --json synth_tang20k.json \
	    -o cst=$(CST) \
	    --timing-allow-fail \
	    --write pnr_tang20k.json
	@echo "=== Gowin 20K P&R done — see pnr_tang20k.json ==="

# ── Pack bitstream ───────────────────────────────────────────────────────
pack: pnr
	@echo "=== gowin_pack: creating 9K bitstream ==="
	$(GOWIN_PACK) -d $(GOWIN_FAMILY) -o design_tang20k.fs pnr_tang20k.json
	@echo "=== Bitstream: design_tang20k.fs ==="

# ── Program ───────────────────────────────────────────────────────────────
prog: pack
	@echo "=== openFPGALoader: programming Tang Nano 9K ==="
	$(OPENFPGALOADER) -b tangnano20k design_tang20k.fs
	@echo "=== Programming done ==="

# ── Clean ─────────────────────────────────────────────────────────────────
clean_synth:
	rm -f synth_tang20k.json synth_tang20k.log pnr_tang20k.json design_tang20k.fs

# ---------------------------------------------------------------------------
# THE CHECK THAT ACTUALLY MATTERS ON THIS BOARD.
#
# PNR_SEED makes the placement REPRODUCIBLE; it does not make it CORRECT. Those
# are different properties, and on GW2A-18C a build can be deterministically
# wrong -- the default placement miscomputes one MNIST class, bit-identically on
# every run (KNOWN_ISSUES.md). Re-running P&R with a fixed seed is byte-for-byte
# reproducible (verified: same seed, two runs, identical pnr.json AND identical
# .fs), so the pinned seed reproduces a placement that was CHECKED once -- and
# this target is that check. Nothing else in the build catches it.
#
# Run after any change to the sources, to yosys, or to the constraints. Needs
# the board plugged in.
UART_PORT ?= /dev/ttyUSB1

verify: prog
	@echo "=== verifying inference accuracy on real hardware ==="
	@out=$$(python3 send_batch.py --port $(UART_PORT) 2>&1); \
	echo "$$out" | tail -2; \
	if echo "$$out" | grep -q "Agreement vs Julia: 100/100"; then \
	  echo "PASS: 100/100 on batch_ref.bin"; \
	else \
	  echo ""; \
	  echo "FAIL: expected 100/100 vs Julia."; \
	  echo "      This part miscomputes one class for SOME placements -- see"; \
	  echo "      KNOWN_ISSUES.md (GW2A-18C placement-dependent miscompute)."; \
	  echo "      Check that synth_gowin still has -noalu: yosys ALU inference"; \
	  echo "      miscomputes on this part (YosysHQ/apicula#514, KNOWN_ISSUES.md)."; \
	  exit 1; \
	fi
