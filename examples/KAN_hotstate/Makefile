# View waveforms
wave:
	$(VIEWER) sim_wf.vcd

# Clean generated files
# NOTE: in THIS repo the hotc-generated files are checked in -- that is the
# whole point, since there is no hotc here to regenerate them. So clean must
# remove only what a build produces. The same recipe is correct in the hotc
# source repo, where these files ARE build output, which is exactly why the
# destructive version survived the copy. Same trap as smith_waterman's
# `make clean` (hotc 5871e964).
clean:
	rm -rf obj_dir obj_dir_ack_probe obj_dir_rw_probe obj_dir_fastload sim_wf.vcd hardware_trace.csv $(MODULE)_sim.csv

.PHONY: all  hw_sim sw_sim compare validate lint wave clean
# ---------------------------------------------------------------------------
# ack_probe: regression test for the kan_sdram_shim request/ack contract.
#
# Drives a synthetic requester that reproduces kan_control.c's
# sdram_write_byte() handshake exactly, and checks that every handshake the
# requester believes completed corresponds to a real CMD_Write on the SDRAM
# pins. Swept across many request spacings ON PURPOSE: the bug this caught
# (sdram_busy passed through sdram.v's busy, so an autonomous refresh in
# flight false-acked the request and the write was silently dropped, ~0.9%
# of bytes) reports clean at some spacings purely by phase luck.
ACK_PROBE_GAPS = 0 1 2 3 5 7 11 13 17 23 40 64 100 137 200 270 400 809 810 811
ACK_PROBE_CYCLES = 3000000

ack_probe:
	@echo "=== Building SDRAM shim ack-contract probe ==="
	$(SIMULATOR) --cc -Wno-fatal --exe --build -O2 --Mdir obj_dir_ack_probe -I. \
	  sim_main_ack_probe.cpp kan_ack_probe.v kan_sdram_shim.v sdram.v \
	  sim_only_sdram_model.v --top kan_ack_probe
	@echo "=== Sweeping request spacings ==="
	@fail=0; for g in $(ACK_PROBE_GAPS); do \
	  ./obj_dir_ack_probe/Vkan_ack_probe $$g $(ACK_PROBE_CYCLES) || fail=1; \
	done; \
	if [ $$fail -ne 0 ]; then echo "ACK PROBE: FAIL"; exit 1; fi; \
	echo "ACK PROBE: PASS (all spacings)"

# rw_probe: does a byte written through the shim read back as that byte?
# ack_probe proves writes are ISSUED; this proves they LAND and that the read
# direction works. It caught two sim-model bugs, each of which presents as a
# compute bug rather than a memory bug, so run this BEFORE debugging inference
# math:
#   - a CAS off-by-one that made every read return 0x00 (all accumulators tie,
#     every image classifies as class 0);
#   - a bank-decode truncation that aliased all four banks onto one, so the
#     6.75 MB weight image silently overwrote itself every 2 MB.
# Both runs below are needed, and both were mutation-tested against the broken
# model to confirm they actually fail on it. The dense run alone CANNOT see the
# bank bug (it never leaves bank 0), and a strided run whose pattern ignores
# the high address bits cannot see it either (aliasing addresses would expect
# the same byte) -- both of those were real false-passes here.
rw_probe:
	$(SIMULATOR) --cc -Wno-fatal --exe --build -O2 --Mdir obj_dir_rw_probe -I. \
	  sim_main_rw_probe.cpp kan_rw_probe.v kan_sdram_shim.v sdram.v \
	  sim_only_sdram_model.v --top kan_rw_probe
	@echo "--- dense: byte-lane / column decode ---"
	./obj_dir_rw_probe/Vkan_rw_probe 4096 1
	@echo "--- full-span stride 1024: bank / row decode (stride chosen so that"
	@echo "    2^21 is a whole multiple of it, which is what makes aliasing"
	@echo "    addresses actually appear in the probe set) ---"
	./obj_dir_rw_probe/Vkan_rw_probe 6592 1024

# fastload: full functional test -- streams all 6,750,208 weight bytes plus
# image(s), checks classification against tb_data.txt's reference scores.
# Clock is toggled from C++ (no --timing): the Verilog-task version was far
# too slow to finish a multi-million-byte load.
fastload:
	$(SIMULATOR) --cc -Wno-fatal --exe --build -O2 --Mdir obj_dir_fastload -I. \
	  sim_main_fastload.cpp kan_fastload_dut.v kan_control_template.v kan_sdram_shim.v \
	  sdram.v sim_only_sdram_model.v \
	  ../../IP/hotstate.sv ../../IP/microcode.sv ../../IP/control.sv \
	  ../../IP/next_address.sv ../../IP/stack.sv ../../IP/switch.sv \
	  ../../IP/timer.sv ../../IP/variable.sv --top kan_fastload_dut
	stdbuf -oL ./obj_dir_fastload/Vkan_fastload_dut

.PHONY: ack_probe rw_probe fastload

