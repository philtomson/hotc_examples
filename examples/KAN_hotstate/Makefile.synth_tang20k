# Makefile.synth_tang20k -- Tang Nano 20K (Gowin GW2AR-LV18QN88C8/I7) synthesis
# for KAN_hotstate. Tang Nano 20K only: the embedded SDRAM this design
# depends on is specific to this board -- there is no 9K or Primer 25K
# variant of this example.
#
# Toolchain:  yosys synth_gowin -> nextpnr-himbaechel -> gowin_pack -> openFPGALoader
# Full flow:  make -f Makefile.synth_tang20k prog
#
# The *_template.v / *.mem / *.vh files are hotc's OUTPUT, checked in as-is --
# this repo does not ship the hotc compiler, so there is no `generate` step.
# The .c sources beside them are included for reference only; editing them has
# no effect here without hotc.
#
# This board is 54 MHz (PLL-derived, SDRAM requirement) with a 2 Mbaud
# UART, not this project's usual 27 MHz/115200 baud -- the UART machines
# encode the baud divisor as a cycle count in C, so uart_tx.c/uart_rx.c
# are retimed via generated wrapper sources under $(BUILD)/, same
# mechanism as Makefile.synth_primer25k. The checked-in UART machines in
# build_tang20k/ are built for 54 MHz / 2 Mbaud (27 cycles per bit).
# Changing the baud requires hotc.
#
# -noalu is REQUIRED, not a tuning knob: yosys's inferred ALU carry cells
# miscompute on GW2A-18C (YosysHQ/apicula#514). Verified here: 0 ALU cells.

IP_DIR    = ../../IP

-include ../../tools.mk
-include ../../local.mk

GOWIN_DEVICE = GW2AR-LV18QN88C8/I7

# Optional placement seed. Normally unset: -noalu is the real fix for this
# part's placement-dependent miscompute (see
# examples/Tsetlin_hotstate_uart/KNOWN_ISSUES.md and YosysHQ/apicula#514),
# and a seed only makes one lucky placement repeatable. Exposed here purely
# so a suspected placement
# dependency can be TESTED -- if the same design passes on one seed and fails
# on another, placement is the variable.
PNR_SEED ?=
GOWIN_FAMILY = GW2A-18C
TOP          = top
CST          = kan_tang20k.cst
BUILD        = build_tang20k



UART_TEMPLATES = $(BUILD)/uart_tx_template.v $(BUILD)/uart_rx_template.v
KAN_TEMPLATE   = kan_control_template.v

SRCS = top.v \
       kan_sdram_shim.v \
       sdram.v \
       gowin_rpll/gowin_rpll.v \
       $(KAN_TEMPLATE) \
       $(UART_TEMPLATES) \
       $(IP_DIR)/hotstate.sv \
       $(IP_DIR)/microcode.sv \
       $(IP_DIR)/control.sv \
       $(IP_DIR)/next_address.sv \
       $(IP_DIR)/timer.sv \
       $(IP_DIR)/variable.sv \
       $(IP_DIR)/switch.sv \
       $(IP_DIR)/stack.sv

.PHONY: all synth pnr pack prog clean_synth

all: pack

# --- retimed UART sources ---------------------------------------------------


# --- synthesis ---------------------------------------------------------------
# -noalu: REQUIRED for correctness on GW2A-18C, not a tuning knob -- yosys's
# inferred ALU carry cells miscompute on this part. See
# examples/Tsetlin_hotstate_uart/KNOWN_ISSUES.md (YosysHQ/apicula#514).
# kan_control.c's accumulator arithmetic (acc = acc + weightN, up to 24
# bits) is exactly the kind of ALU-carry-chain-heavy construct that bug hits.
#
# NOTE: no standalone `hierarchy -check` before synth_gowin -- synth_gowin
# loads the Gowin primitive cell library (rPLL, etc., needed for
# gowin_rpll.v's PLL instance) and runs its own hierarchy pass internally;
# a hierarchy check that runs first doesn't know about those cells yet and
# errors on any design that instantiates a Gowin primitive. Same fix
# examples/hdmi_gpu's Makefile.synth_tang20k already documents.
# KNOWN-GOOD YOSYS: 0.56. Newer yosys is NOT usable for this design.
#
# Measured 2026-09-22, same sources, same flags, only the toolchain differing:
#
#   yosys 0.56+186                      0 $buf in top; places, packs, and RUNS
#                                       on hardware. This is the pinned version.
#   yosys 0.69+62                       3 $buf in top; nextpnr-himbaechel stops:
#                                       "unable to place cell
#                                       ...states_$buf_Y of type $buf".
#   yosys 0.69+117 +                    IDENTICAL failure on a fresh nightly
#   nextpnr 0.11.1-31                   with BOTH tools newer. Not fixed
#                                       upstream -- do not assume a newer
#                                       oss-cad-suite helps; retest cheaply
#                                       (3 s synth + count $buf) before
#                                       spending a build on it.
#
# The 3 $buf are NOT junk. They are wide alias buffers on `states` (253 bits),
# `effective_state_value` (253 bits) and `combined` (16 bits) -- vectors the RTL
# assembles from many separate per-bit drivers (see the per-bit always blocks in
# IP/microcode.sv). Buffered-normalized mode inserts one buffer per such vector
# to give it a single driving port, so they carry real connectivity.
#
# Workarounds tried, none acceptable:
#
#   bufnorm -conn / -bits   The documented exit from buffered-normalized mode,
#                           and semantically the right operation (replace the
#                           buffers with direct connections). Removes the $buf,
#                           then P&R dies with
#                           "Unconstrained IO:IO_sdram_dq_IOBUF_IO_9".
#                           This cst deliberately constrains NO SDRAM pins: the
#                           in-package SDRAM is auto-assigned by himbaechel, and
#                           -conn disturbs the IO net naming that depends on.
#                           Same error on the new nightly.
#
#   techmap t:$buf          Places and packs CLEANLY -- and produces a DEAD
#                           bitstream. led[5] is a free-running heartbeat
#                           outside reset (top.v) and does not blink; confirmed
#                           dark with BOTH kan_tang20k.cst and
#                           kan_tang20k_extuart.cst, against 0.56 builds on the
#                           same cst files that do blink. It "works" by deleting
#                           those 253-bit alias nets, which is why the result
#                           has no clock.
#
#                           => On this flow a clean P&R + gowin_pack proves
#                           NOTHING about the design. Check the heartbeat.
#
# 0.69 differs beyond the buffers: it infers MULT18X18/MULT9X9 DSP macros 0.56
# does not, moves 3 flops DFF->DFFS, and shifts the LUT mix. -nodsp drops the
# DSPs but the $buf and the LUT delta remain, so DSP inference is not the cause.
# The hotstate IP alone (-top kan_control) shows 0 $buf on both versions -- the
# buffers appear only once everything is flattened into top, so there is no
# small reproducer. Root cause not isolated; not yet reported upstream.
#
# BUFFIX is the A/B knob that found this, and is EMPTY by default on purpose.
# Do not enable it to "fix" a $buf P&R failure: it hides the failure rather than
# fixing it. Use yosys 0.56:  make -f Makefile.synth_tang20k prog YOSYS=/usr/local/bin/yosys
BUFFIX ?=

# synth_gowin's -json shortcut is deliberately NOT used, so that BUFFIX can be
# injected between mapping and JSON writeout.
synth: $(KAN_TEMPLATE) $(UART_TEMPLATES)
	$(TOOL_BANNER)
	@echo "=== Yosys Gowin synthesis for $(TOP) (Tang Nano 20K) ==="
	$(YOSYS) -ql synth_tang20k.log -p " \
	  read_verilog -sv $(SRCS); \
	  synth_gowin -noalu -top $(TOP); \
	  $(BUFFIX) \
	  write_json synth_tang20k.json; \
	  stat"
	@echo "=== Gowin 20K synthesis done — see synth_tang20k.log ==="

pnr: synth
	@echo "=== nextpnr-himbaechel Gowin 20K place and route ==="
	# --timing-allow-fail: same rationale as this project's other Tang Nano
	# 20K flows -- nextpnr-himbaechel's hold model is conservative on the
	# shared hotstate.sv IP core's internal LUT chains. Confirm real
	# behaviour on hardware, not the static timing report.
	$(NEXTPNR_HIMB) \
	    --device $(GOWIN_DEVICE) \
	    -o family=$(GOWIN_FAMILY) \
	    --json synth_tang20k.json \
	    -o cst=$(CST) \
	    --timing-allow-fail \
	    $(if $(PNR_SEED),--seed $(PNR_SEED)) \
	    --write pnr_tang20k.json
	@echo "=== Gowin 20K P&R done — see pnr_tang20k.json ==="

pack: pnr
	@echo "=== gowin_pack: creating 20K bitstream ==="
	$(GOWIN_PACK) -d $(GOWIN_FAMILY) -o design_tang20k.fs pnr_tang20k.json
	@echo "=== Bitstream: design_tang20k.fs ==="

prog: pack
	@echo "=== openFPGALoader: programming Tang Nano 20K ==="
	$(OPENFPGALOADER) -b tangnano20k design_tang20k.fs
	@echo "=== Programming done ==="

# NOTE: in THIS repo the hotc-generated files are checked in -- that is the
# whole point, since there is no hotc here to regenerate them. So clean_synth must
# remove only what a build produces. The same recipe is correct in the hotc
# source repo, where these files ARE build output, which is exactly why the
# destructive version survived the copy. Same trap as smith_waterman's
# `make clean` (hotc 5871e964).
# $(BUILD) holds the UART machines' checked-in templates and .mem files; an
# `rm -rf $(BUILD)` here took out 14 tracked files.
clean_synth:
	rm -f synth_tang20k.json synth_tang20k.log pnr_tang20k.json design_tang20k.fs
